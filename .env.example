# TechLab+ TROQ — exemplo de variáveis de ambiente
#
# Espelho versionado do catalogo de docs/engineering/environments.md, secao 5.
# Mesmos nomes, mesma ordem de areas, NENHUM valor real.
#
# COMO USAR
#   1. Copie este arquivo para `.env.local` (ou equivalente) na sua maquina.
#   2. Substitua cada placeholder pelo valor do ambiente `development`.
#   3. O arquivo derivado NAO e versionado: `.gitignore` ignora `.env` e
#      `.env.*`, com excecao apenas deste `.env.example`.
#
# REGRAS QUE ESTE ARQUIVO MATERIALIZA
#   - Nenhum segredo real entra aqui, em nenhuma circunstancia (RNF-015).
#   - Placeholders sao obviamente ficticios: hosts usam o dominio reservado
#     `example.invalid`, que por definicao nunca resolve (RFC 2606, RFC 6761),
#     e segredos usam o literal `SUBSTITUIR_...`.
#   - Variavel prefixada com `NEXT_PUBLIC_` e, por definicao, CONTEUDO PUBLICO:
#     o valor vai para o bundle de cliente. Nenhum segredo usa esse prefixo.
#   - Credencial de producao nunca e usada em `development` nem em `preview`.
#   - Nenhum dado pessoal real e nenhum telefone/WhatsApp entram aqui.
#
# ESTADO
#   Duas variaveis sao lidas por codigo hoje: DIRECT_URL (prisma.config.ts,
#   Prisma CLI, desde F1-002) e DATABASE_URL (src/persistence/prisma.ts,
#   runtime do Prisma Client, desde F1-003). Todas as demais estao `previsto`
#   em docs/engineering/environments.md, secao 5. Este arquivo e o contrato,
#   nao evidencia de integracao existente. O banco de `preview` (Neon) foi
#   provisionado por F1-004; os valores reais vivem no GitHub Environment
#   `preview` e no escopo Preview da Vercel, nunca aqui (database.md, secao 15).
#   A area 8 (Sentry) entrou por F1-008, que ESCOLHEU o provedor em ADR-0007
#   mas NAO provisionou nada, NAO gerou credencial e NAO instalou SDK.


# -----------------------------------------------------------------------------
# 1. Aplicacao  (environments.md, secao 5.1)
# -----------------------------------------------------------------------------

# Publica. URL canonica da aplicacao no ambiente.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side. Ambiente corrente: development | preview | production.
APP_ENV=development


# -----------------------------------------------------------------------------
# 2. PostgreSQL / Neon  (environments.md, secao 5.2)
# -----------------------------------------------------------------------------

# Server-side, SEGREDO. Conexao da aplicacao em runtime: endpoint POOLED.
# Consumida por src/persistence/prisma.ts (Prisma Client + @prisma/adapter-pg),
# lida de forma lazy na primeira vez em que um client e pedido. Em development
# o Next.js carrega `.env.local` por conta propria.
DATABASE_URL=postgresql://SUBSTITUIR_USUARIO:SUBSTITUIR_SENHA@pooled.example.invalid:5432/troq?sslmode=require

# Server-side, SEGREDO. Conexao DIRETA (nao pooled), usada pelo CLI do Prisma
# em operacoes de schema. ADR-0005, decisao 10. Consumida por prisma.config.ts,
# que carrega `.env.local` (ou `.env`) automaticamente em desenvolvimento.
DIRECT_URL=postgresql://SUBSTITUIR_USUARIO:SUBSTITUIR_SENHA@direct.example.invalid:5432/troq?sslmode=require


# -----------------------------------------------------------------------------
# 3. Cloudflare R2 — API S3-compatible  (environments.md, secao 5.3)
# -----------------------------------------------------------------------------

# Server-side. Endpoint S3-compatible da conta.
R2_S3_ENDPOINT=https://s3.example.invalid

# Server-side. Regiao exigida pelo protocolo de assinatura S3.
R2_REGION=auto

# Server-side. Bucket de imagens do ambiente (duas areas logicas: temporaria e
# publica; nao dois buckets).
R2_BUCKET=troq-media-development

# Server-side, SEGREDO.
R2_ACCESS_KEY_ID=SUBSTITUIR_R2_ACCESS_KEY_ID

# Server-side, SEGREDO.
R2_SECRET_ACCESS_KEY=SUBSTITUIR_R2_SECRET_ACCESS_KEY

# Publica. Host dos derivados publicos (thumb, medium, large). Nunca endereca
# o original temporario.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.invalid


# -----------------------------------------------------------------------------
# 4. Resend — email transacional  (environments.md, secao 5.4)
# -----------------------------------------------------------------------------

# Server-side, SEGREDO.
RESEND_API_KEY=SUBSTITUIR_RESEND_API_KEY

# Server-side. Remetente em dominio verificado no provedor.
EMAIL_FROM=TROQ <nao-responda@example.invalid>


# -----------------------------------------------------------------------------
# 5. Autenticacao — Better Auth  (environments.md, secao 5.5)
# -----------------------------------------------------------------------------

# Server-side, SEGREDO. Assinatura de sessao e de tokens.
BETTER_AUTH_SECRET=SUBSTITUIR_BETTER_AUTH_SECRET

# Server-side. URL base do servidor de autenticacao no ambiente.
BETTER_AUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 6. Mercado Pago — gateway Pix  (environments.md, secao 5.6)
# -----------------------------------------------------------------------------
#
# A URL de webhook NAO e variavel de ambiente: ela e configurada no nivel da
# aplicacao, no painel do Mercado Pago. Enviar `notification_url` no corpo de
# `POST /v1/orders` e PROIBIDO (ADR-0004, decisao 11).

# Server-side, SEGREDO.
MERCADO_PAGO_ACCESS_TOKEN=SUBSTITUIR_MERCADO_PAGO_ACCESS_TOKEN

# Server-side, SEGREDO. Valida a assinatura HMAC-SHA256 da notificacao.
MERCADO_PAGO_WEBHOOK_SECRET=SUBSTITUIR_MERCADO_PAGO_WEBHOOK_SECRET


# -----------------------------------------------------------------------------
# 7. Jobs internos e agendamento  (environments.md, secao 5.7)
# -----------------------------------------------------------------------------

# Server-side, SEGREDO. Protege os endpoints de trabalho periodico; a plataforma
# o envia como cabecalho `Authorization` (ADR-0006, decisao 9).
CRON_SECRET=SUBSTITUIR_CRON_SECRET


# -----------------------------------------------------------------------------
# 8. Observabilidade — Sentry  (environments.md, secao 5.8)
# -----------------------------------------------------------------------------
#
# Provedor homologado por ADR-0007 (DEC-039). UM PROJETO SENTRY POR AMBIENTE e
# UM DSN POR AMBIENTE: projeto e DSN nunca sao compartilhados entre
# `development`, `preview` e `production` (environments.md, secoes 2 e 6.1).
#
# ESTA TAREFA NAO IMPLEMENTA O SDK. Nada esta provisionado: nao existe conta,
# organizacao nem projeto Sentry, `@sentry/nextjs` nao esta instalado e nenhuma
# telemetria e emitida. TODAS as quatro variaveis abaixo estao `previsto`.
#
# NAO existe SENTRY_ENVIRONMENT nem NEXT_PUBLIC_SENTRY_ENVIRONMENT: o rotulo do
# ambiente e APP_ENV (secao 1 deste arquivo). NAO existe variavel propria de
# release. NAO existe uma segunda SENTRY_DSN duplicando o mesmo valor: a
# instrumentacao server-side usa explicitamente a DSN publica abaixo
# (ADR-0007, decisoes 11 e 12).
#
# Session Replay fica FORA do MVP e permanece desabilitado (ADR-0007, decisao 9).
# Nenhum sinal de telemetria contem telefone/WhatsApp, dado pessoal, token,
# cookie de sessao, cabecalho Authorization, segredo, string de conexao, request
# body arbitrario nem payload integral de webhook (AR-14.4, RNF-018).

# Publica, e NAO e segredo: a DSN e lida pelo navegador, logo o seu valor vai
# para o bundle de cliente. E chave de INGESTAO enderecada — nao le issues, nao
# le logs, nao administra projeto e nao emite credencial. Ser publica nao
# autoriza expor nenhuma outra credencial. Um valor distinto por ambiente.
NEXT_PUBLIC_SENTRY_DSN=https://exemplo@o0.ingest.example.invalid/0

# Server-side, SEGREDO. Autentica operacoes na organizacao Sentry e existe
# APENAS para build/CI que realmente precise delas (upload de source maps,
# criacao de release). CONDICIONAL: nao e necessaria para `npm run dev`, nem
# para build local, lint, typecheck ou test:ci, se nao houver upload de
# artefatos. Menor escopo permitido pelo provedor; credencial distinta por
# ambiente. NUNCA prefixada com NEXT_PUBLIC_ e nunca lida em runtime.
SENTRY_AUTH_TOKEN=SUBSTITUIR_SENTRY_AUTH_TOKEN

# Server-side, NAO e segredo. Slug da organizacao Sentry; configuracao de build.
# Condicional a integracao de source maps/releases.
SENTRY_ORG=SUBSTITUIR_SENTRY_ORG

# Server-side, NAO e segredo. Slug do projeto Sentry DO AMBIENTE; valor
# diferente por ambiente. Condicional a integracao de source maps/releases.
SENTRY_PROJECT=SUBSTITUIR_SENTRY_PROJECT
