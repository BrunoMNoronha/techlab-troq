{
  "name": "techlab-troq",
  "version": "0.0.0",
  "private": true,
  "description": "TechLab+ TROQ — plataforma de anúncios entre pessoas",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "brand:generate": "node scripts/brand/generate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:deployment": "node --test scripts/deploy/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "10.74.0",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
